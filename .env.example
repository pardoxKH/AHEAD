# Copy to .env (never commit it) and fill in. Read by apps/web; validated at startup in apps/web/src/env.ts.

# Postgres connection string. Tests that wipe data require a database name ending in _test.
DATABASE_URL=postgres://ahead:ahead@localhost:5432/ahead

# OAuth client (type "Web application") from Google Cloud Console. Add
# ${APP_URL}/api/auth/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public base URL of the web app, no trailing slash. The OAuth redirect URI is built from it.
APP_URL=http://localhost:3000

# The one Google account allowed to sign in. Any other account is refused.
ALLOWED_EMAIL=

# 32 random bytes, base64. Encrypts Google refresh tokens at rest. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# At least 32 characters. Signs session cookies; changing it signs everyone out. Generate: openssl rand -base64 48
SESSION_SECRET=

# Claude API key, used to turn the imported Google Doc task queue into proposed tasks.
ANTHROPIC_API_KEY=
